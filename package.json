{
  "name": "good-ai",
  "version": "0.1.2",
  "description": "A local-first memory layer for successful AI interactions.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter good-ai dev",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tests": "pnpm -r typecheck:tests",
    "validate": "pnpm format:check && pnpm build && pnpm typecheck && pnpm typecheck:tests && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
