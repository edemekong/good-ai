{
  "name": "@thinkinteltech/good-ai",
  "version": "0.1.3",
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "bin": {
    "good-ai": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && node scripts/copy-skill.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "test": "vitest run tests --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@thinkinteltech/core": "workspace:*",
    "@thinkinteltech/mcp": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
